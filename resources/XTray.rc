#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

1 RT_MANIFEST "XTray.manifest"
IDI_XTRAY ICON "XTray.ico"
#include "svg-icons.rc"

IDD_SETTINGS DIALOGEX 0, 0, 430, 305
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XTray Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Xray executable:", IDC_LABEL_EXECUTABLE, 12, 12, 390, 12
    EDITTEXT IDC_EXECUTABLE, 12, 27, 328, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_BROWSE_EXECUTABLE, 347, 27, 70, 15

    LTEXT "Config files (one per line, in load order; optional):", IDC_LABEL_CONFIG_FILES, 12, 51, 390, 12
    EDITTEXT IDC_CONFIG_FILES, 12, 66, 328, 75, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON "Add files...", IDC_ADD_FILES, 347, 66, 70, 16

    LTEXT "Config directory (optional):", IDC_LABEL_CONFIG_DIRECTORY, 12, 149, 390, 12
    EDITTEXT IDC_CONFIG_DIRECTORY, 12, 164, 328, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_BROWSE_DIRECTORY, 347, 164, 70, 15

    LTEXT "Log lines per source:", IDC_LABEL_LOG_LINES, 12, 190, 108, 12
    EDITTEXT IDC_LOG_LINES, 124, 187, 70, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT "Language:", IDC_LABEL_LANGUAGE, 12, 213, 48, 12
    COMBOBOX IDC_LANGUAGE, 66, 210, 125, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Appearance:", IDC_LABEL_THEME, 207, 213, 55, 12
    COMBOBOX IDC_THEME, 266, 210, 151, 80, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    CONTROL "Start XTray and Xray when I sign in", IDC_LOGON_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 234, 405, 14
    LTEXT "Relative paths use the XTray.exe directory.", IDC_HINT_RELATIVE, 12, 256, 400, 12
    LTEXT "Paths apply on the next run/restart; at least one config source is required.", IDC_HINT_APPLY, 12, 269, 405, 12

    DEFPUSHBUTTON "Save", IDOK, 271, 286, 70, 15
    PUSHBUTTON "Cancel", IDCANCEL, 347, 286, 70, 15
END
