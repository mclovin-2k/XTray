#include <windows.h>
#include "resource.h"

#pragma code_page(65001)

1 RT_MANIFEST "XTray.manifest"
IDI_XTRAY ICON "XTray.ico"
#include "svg-icons.rc"

IDD_SETTINGS DIALOGEX 0, 0, 430, 305
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON "Save", IDOK, 271, 286, 70, 15
    PUSHBUTTON "Cancel", IDCANCEL, 347, 286, 70, 15
END

IDD_SETTINGS_CONTENT DIALOGEX 0, 0, 430, 282
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS | WS_VSCROLL
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Language:", IDC_LABEL_LANGUAGE, 12, 12, 48, 12
    COMBOBOX IDC_LANGUAGE, 66, 9, 125, 80, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Appearance:", IDC_LABEL_THEME, 207, 12, 55, 12
    COMBOBOX IDC_THEME, 266, 9, 151, 80, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Log lines per source:", IDC_LABEL_LOG_LINES, 12, 217, 108, 12
    EDITTEXT IDC_LOG_LINES, 124, 214, 70, 15, ES_NUMBER | ES_AUTOHSCROLL

    LTEXT "Xray executable:", IDC_LABEL_EXECUTABLE, 12, 39, 390, 12
    EDITTEXT IDC_EXECUTABLE, 12, 54, 328, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_BROWSE_EXECUTABLE, 347, 54, 70, 15

    LTEXT "Config files (one per line, in load order; optional):", IDC_LABEL_CONFIG_FILES, 12, 78, 390, 12
    EDITTEXT IDC_CONFIG_FILES, 12, 93, 328, 75, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON "Add files...", IDC_ADD_FILES, 347, 93, 70, 16

    LTEXT "Config directory (optional):", IDC_LABEL_CONFIG_DIRECTORY, 12, 176, 390, 12
    EDITTEXT IDC_CONFIG_DIRECTORY, 12, 191, 328, 15, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_BROWSE_DIRECTORY, 347, 191, 70, 15

    CONTROL "Load config directory before config files", IDC_CONFIG_DIRECTORY_FIRST, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 211, 405, 14
    LTEXT "Applies when both are set; later inputs follow Xray's merge rules.", IDC_HINT_CONFIG_ORDER, 12, 228, 405, 12
    PUSHBUTTON "Check current configuration", IDC_CHECK_CONFIG, 12, 214, 100, 15
    PUSHBUTTON "Preview current configuration", IDC_PREVIEW_CONFIG, 118, 214, 110, 15
    LTEXT "Uses this form without saving.", IDC_HINT_CONFIG_TOOLS, 12, 232, 405, 12
    CONTROL "Start XTray and Xray when I sign in", IDC_LOGON_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 234, 405, 14
    LTEXT "Relative paths use the XTray.exe directory.", IDC_HINT_RELATIVE, 12, 256, 400, 12
    LTEXT "Paths and load order apply on the next run/restart; at least one config source is required.", IDC_HINT_APPLY, 12, 269, 405, 12

END
